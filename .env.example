# ==============================================================================
# Signova AI - Environment Configuration Template
# Copy this file to .env and adjust values for local development.
# ==============================================================================

# Application Configuration
APP_NAME="Signova AI"
APP_ENV=development
DEBUG=true

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration (Vite)
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://127.0.0.1:8000

# AI/ML Execution & Model Paths
MODEL_DEVICE=cpu
MODEL_PATH=models/checkpoints/

# iSign T5 Pose-to-Text Model Configuration (F-012)
ISIGN_MODEL_DIR=D:/iSign-t5-pose-to-text
ISIGN_CHECKPOINT_NAME=t5-base
ISIGN_TOKENIZER_DIR=models/tokenizer/t5-small
ISIGN_OFFLINE=true

# Database (Optional - for future user/session history)
DATABASE_URL=

# Speech & External Language Services (FE-08 Sarvam AI)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_TIMEOUT_SECONDS=15.0
